# Copy this file to .env and fill it in. Never commit .env.

# The workshop key (starts with sk-or-). Tutorial 3's research_tools reads this name too.
OPENROUTER_API_KEY=""

# Optional and free: https://openalex.org/settings/api
OPENALEX_API_KEY=""

# A team email address. It puts our Crossref requests in the polite pool.
CROSSREF_MAILTO=""

# Optional: only if we keep Telegram.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 1 = serve cached API and LLM answers only (the demo fallback).
REPLAY=0
